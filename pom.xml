			<build>
				<plugins>
					<plugin>
						<groupId>org.owasp</groupId>
						<artifactId>dependency-check-maven</artifactId>
						<version>13.0.0</version>
						<configuration>
							<skipProvidedScope>true</skipProvidedScope>
							<skipRuntimeScope>true</skipRuntimeScope>
							<skipSystemScope>true</skipSystemScope>
							<skipTestScope>true</skipTestScope>
							<failBuildOnCVSS>9.0</failBuildOnCVSS>
							<formats>
								<format>XML</format>
								<format>HTML</format>
								<format>JSON</format>
							</formats>
							<nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
							<suppressionFiles>
								<suppressionFile>owasp/owasp-suppress.xml</suppressionFile>
							</suppressionFiles>
						</configuration>
						<executions>
							<execution>
								<id>owasp-verify</id>
								<phase>verify</phase>
								<goals>
									<goal>check</goal>
									<goal>aggregate</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
