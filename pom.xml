<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.projecthusky.fhir</groupId>
	<artifactId>husky-fhir</artifactId>
	<name>Husky FHIR</name>
	<packaging>pom</packaging>
	<version>4.0.0-SNAPSHOT</version>
	<description>
		Husky FHIR is a Java library for working with FHIR resources. It
		provides a set of tools and utilities for parsing, validating, and
		manipulating FHIR data in Java applications.
		Implementations of Swiss FHIR profiles are provided in the
		husky-fhir-emed-ch and husky-fhir-vacd modules. Further Swiss FHIR
		profiles can be implemented in separate modules and added to the
		husky-fhir project.
	</description>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.build.timestamp.format>yyyy-MM-dd HH:mm</maven.build.timestamp.format>
		<maven.compiler.proc>full</maven.compiler.proc>
		<java.version>21</java.version>
		<maven.compiler.release>${java.version}</maven.compiler.release>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<slf4j.version>2.0.16</slf4j.version>
		<junit.version>5.10.0</junit.version>
		<maven-surefire-plugin.version>3.0.0</maven-surefire-plugin.version>
		<hapi.fhir.version>8.8.1</hapi.fhir.version>
		<org.hl7.fhir.version>6.7.9</org.hl7.fhir.version>
		<hapi.version>2.6.0</hapi.version> <!-- HL7v2 -->
		<zxing.version>3.5.3</zxing.version>
		<openhtmltopdf-version>1.1.26</openhtmltopdf-version>
		<fasterxml.version>2.17.2</fasterxml.version>
		<jakarta.xml.version>3.0.1</jakarta.xml.version>
		<jakarta.xml.ws-api.version>4.0.2</jakarta.xml.ws-api.version>
		<logback.version>1.5.16</logback.version>
	</properties>
	<scm>
		<connection>scm:git:https://github.com/project-husky/husky-fhir.git</connection>
		<developerConnection>scm:git:git@github.com:project-husky/husky-fhir.git</developerConnection>
		<url>https://github.com/project-husky/husky-fhir/tree/master</url>
		<tag>HEAD</tag>
	</scm>
	<modules>
		<module>husky-fhir-structures</module>
		<module>husky-fhir-communication</module>
		<module>husky-fhir-emed-ch</module>
		<module>husky-fhir-vacd</module>
		<module>husky-fhir-core-ch</module>
		<module>husky-fhir-validation</module>
